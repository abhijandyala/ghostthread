# Copy to .env and fill in whatever you have. Every integration degrades to a
# local path when its credential is absent, so a half-filled file still runs.

# --- HydraDB (real-time grounding) ------------------------------------------
HYDRA_TOKEN=
HYDRA_DATABASE=ghostthread
HYDRA_TENANT_ID=ghostthread
# HYDRA_BASE_URL=https://api.hydradb.com

# --- Pipeshift (two deployed models) ----------------------------------------
# Note: base URL is /api/v0, NOT /v1.
# One key, two deployments: a fast instruction model for classification and a
# code model for patch generation. Both go through the same endpoint.
PIPESHIFT_API_KEY=
PIPESHIFT_BASE_URL=https://api.pipeshift.com/api/v0
PIPESHIFT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
PIPESHIFT_CODE_MODEL=deepseek-ai/deepseek-coder-6.7b-instruct

# --- InsForge (intent profile) ----------------------------------------------
INSFORGE_BASE_URL=https://your-app.insforge.app
INSFORGE_API_KEY=
INSFORGE_TABLE=intent_profiles
INSFORGE_PROFILE_KEY=ghostthread
INTENT_PROFILE_TTL_SECONDS=5
# Idempotency log (pipeline node N8). UNIQUE on complaint_id. Without InsForge
# credentials this degrades to an in-process dict that does not survive a
# restart, and the UI says so.
INSFORGE_ACTIONS_TABLE=actions_log

# --- Coding agent fallback (NOT the graded Pipeshift requirement) -----------
# Only used when PIPESHIFT_API_KEY is empty. Patches drafted this way are
# labelled degraded everywhere they appear.
ANTHROPIC_API_KEY=
CODING_AGENT_MODEL=claude-sonnet-4-20250514

# --- Read/write connectors --------------------------------------------------
SLACK_TOKEN=
GMAIL_TOKEN=
LINEAR_TOKEN=
LINEAR_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPO=

# --- Safety -----------------------------------------------------------------
# Leave true until you are on stage. Controls whether tickets, patches and
# replies are actually sent.
DRY_RUN=true
