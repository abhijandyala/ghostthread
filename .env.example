# Copy to .env and fill in whatever you have. Every integration degrades to a
# local path when its credential is absent, so a half-filled file still runs.

# --- HydraDB (real-time grounding) ------------------------------------------
HYDRA_TOKEN=
HYDRA_DATABASE=ghostthread
HYDRA_TENANT_ID=ghostthread
# HYDRA_BASE_URL=https://api.hydradb.com

# --- Anthropic (two specialised models, one key) ----------------------------
# Classification and code generation are different tasks and use different
# models. Both run under structured outputs, so the schema is enforced during
# generation rather than parsed out of prose afterwards.
# With this key absent, extraction degrades to a keyword scorer (labelled
# `heuristic` in the UI) and fix generation is switched off entirely -- it never
# invents a patch.
ANTHROPIC_API_KEY=
# Leave these unset to take the defaults. A BLANK value is treated as unset, so
# `EXTRACTION_MODEL=` will not send an empty model id to the API.
EXTRACTION_MODEL=claude-haiku-4-5
CODING_AGENT_MODEL=claude-opus-5
# Thinking is on by default on the code model and max_tokens caps thinking plus
# response together, so this needs room for both.
CODING_AGENT_MAX_TOKENS=8000
CODING_AGENT_EFFORT=medium

# --- InsForge (intent profile) ----------------------------------------------
INSFORGE_BASE_URL=https://your-app.insforge.app
INSFORGE_API_KEY=
INSFORGE_TABLE=intent_profiles
INSFORGE_PROFILE_KEY=ghostthread
INTENT_PROFILE_TTL_SECONDS=5
# Idempotency log (pipeline node N8). UNIQUE on complaint_id. Without InsForge
# credentials this degrades to an in-process dict that does not survive a
# restart, and the UI says so.
INSFORGE_ACTIONS_TABLE=actions_log
# Node N4 is served by the `policy-read` edge function; set empty to read the
# intent_profiles table directly instead. Deploy both functions with
# scripts/deploy_edge_functions.py.
INSFORGE_POLICY_FUNCTION=policy-read
INSFORGE_DASHBOARD_FUNCTION=memory-dashboard

# --- RocketRide Cloud --------------------------------------------------------
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=
# The public URL of THIS service, as RocketRide's HTTP tool node must reach it.
# The pipeline refers to ${ROCKETRIDE_GHOSTTHREAD_URL} and resolves it from the
# RocketRide account environment, so this local copy is only for the scripts
# that print or check the endpoint. scripts/serve_public.py produces one.
ROCKETRIDE_GHOSTTHREAD_URL=
PUBLIC_PORT=8000

# --- Read/write connectors --------------------------------------------------
SLACK_TOKEN=
GMAIL_TOKEN=
LINEAR_TOKEN=
LINEAR_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPO=

# --- Safety -----------------------------------------------------------------
# Leave true until you are on stage. Controls whether tickets, patches and
# replies are actually sent.
DRY_RUN=true
